{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemiCommandResult",
  "type": "object",
  "required": ["schema_version", "command_id", "event_id", "robot_id", "status", "results"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "command_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "robot_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["success", "partial_success", "failed", "cancelled", "timeout"]
    },
    "results": { "type": "array" },
    "finished_at_ms": { "type": "integer" }
  },
  "additionalProperties": true
}
