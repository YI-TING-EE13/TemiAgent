@@ -39,6 +39,37 @@ class TestShouldCompress:
 
 
 
+class TestContextScaledThreshold:
+    def _compressor_for(self, context_length: int) -> ContextCompressor:
+        with patch("agent.context_compressor.get_model_context_length", return_value=context_length):
+            return ContextCompressor(
+                model="test/model",
+                threshold_percent=0.50,
+                quiet_mode=True,
+            )
+
+    def test_legacy_32k_threshold_is_percentage_based(self):
+        compressor = self._compressor_for(32_000)
+        assert compressor.threshold_tokens == 16_000
+
+    def test_64k_context_does_not_compress_at_historical_estimate(self):
+        compressor = self._compressor_for(64_000)
+        assert compressor.context_length == 64_000
+        assert compressor.threshold_tokens == 32_000
+        assert compressor.should_compress(prompt_tokens=28_943) is False
+
+    def test_64k_threshold_boundary_remains_proactive(self):
+        compressor = self._compressor_for(64_000)
+        assert compressor.should_compress(prompt_tokens=31_999) is False
+        assert compressor.should_compress(prompt_tokens=32_000) is True
+        assert compressor.should_compress(prompt_tokens=32_001) is True
+
+    def test_update_model_recalculates_threshold_from_new_context(self):
+        compressor = self._compressor_for(32_000)
+        compressor.update_model("test/model", 64_000)
+        assert compressor.threshold_tokens == 32_000
+
