+"""Regression tests for bounded compression failure handling."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+import run_agent
+from run_agent import AIAgent, HermesConversationError
+
+
+def _make_context_error() -> Exception:
+    error = Exception(
+        "The prompt exceeds the available context length; please reduce the length"
+    )
+    error.status_code = 400
+    return error
+
+
+def _mock_response(content: str = "ok") -> SimpleNamespace:
+    message = SimpleNamespace(
+        content=content,
+        tool_calls=None,
+        reasoning_content=None,
+        reasoning=None,
+    )
+    choice = SimpleNamespace(message=message, finish_reason="stop")
+    return SimpleNamespace(choices=[choice], model="test/model", usage=None)
+
+
+@pytest.fixture()
+def agent() -> AIAgent:
+    with (
+        patch("run_agent.get_tool_definitions", return_value=[]),
+        patch("run_agent.check_toolset_requirements", return_value={}),
+        patch("run_agent.OpenAI"),
+    ):
+        candidate = AIAgent(
+            api_key="test-key",
+            base_url="https://example.invalid/v1",
+            provider="custom",
+            model="test/model",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+        )
+    candidate.client = MagicMock()
+    candidate._cached_system_prompt = "You are helpful."
+    candidate._use_prompt_caching = False
+    candidate.tool_delay = 0
+    candidate.save_trajectories = False
+    candidate.compression_enabled = True
+    return candidate
+
+
+def test_three_context_compression_failures_preserve_original_category(agent: AIAgent) -> None:
+    """A bounded retry exhaustion must become a structured failure, not KeyError."""
+    error = _make_context_error()
+    agent.context_compressor.context_length = 64_000
+    agent.context_compressor.threshold_tokens = 32_000
+    agent.client.chat.completions.create.side_effect = [error, error, error, error]
+
+    compressed_messages = [{"role": "user", "content": "hello"}]
+    with (
+        patch.object(
+            agent,
+            "_compress_context",
+            side_effect=[
+                (compressed_messages, "compressed-1"),
+                (compressed_messages, "compressed-2"),
+                (compressed_messages, "compressed-3"),
+            ],
+        ),
+        patch.object(agent, "_persist_session"),
+        patch.object(agent, "_save_trajectory"),
+        patch.object(agent, "_cleanup_task_resources"),
+    ):
+        with pytest.raises(HermesConversationError) as raised:
+            agent.chat("hello")
+
+    failure = raised.value.to_dict()
+    assert failure["error_class"] == "hermes_compression_exhausted"
+    assert failure["original_failure_category"] == "context_overflow"
+    assert failure["retryable"] is True
+    assert "context" in failure["safe_message"].lower()
+
+
+def test_single_turn_context_compression_is_deterministically_unchanged(agent: AIAgent) -> None:
+    """A one-turn prompt has no removable middle for the compressor."""
+    messages = [{"role": "user", "content": "synthetic request"}]
+    with patch("agent.context_compressor.call_llm") as compression_model:
+        result = agent.context_compressor.compress(messages, current_tokens=11_508)
+
+    assert result == messages
+    compression_model.assert_not_called()
+
+
+def test_chat_handles_result_without_final_response(agent: AIAgent) -> None:
+    """The chat convenience API must not index a missing result field."""
+    with patch.object(
+        agent,
+        "run_conversation",
+        return_value={
+            "failed": True,
+            "error": "context overflow",
+            "failure_category": "context_overflow",
+        },
+    ):
+        with pytest.raises(HermesConversationError) as raised:
+            agent.chat("hello")
+
+    assert raised.value.original_failure_category == "context_overflow"
+
+
+@pytest.mark.parametrize("result", [{"final_response": ""}, {"final_response": "ok"}])
+def test_chat_success_path_is_unchanged(agent: AIAgent, result: dict[str, str]) -> None:
+    with patch.object(agent, "run_conversation", return_value=result):
+        assert agent.chat("hello") == result["final_response"]
+
+
+def test_chat_preserves_compression_model_failure_category(agent: AIAgent) -> None:
+    """A compression/parser category must survive the safe failure boundary."""
+    result = {
+        "failed": True,
+        "error": "summary parser failed",
+        "failure": {
+            "error_class": "hermes_compression_exhausted",
+            "safe_message": "ignored by the safe boundary",
+            "retryable": False,
+            "original_failure_category": "compression_model_failure",
+        },
+    }
+    with patch.object(agent, "run_conversation", return_value=result):
+        with pytest.raises(HermesConversationError) as raised:
+            agent.chat("hello")
+
+    assert raised.value.original_failure_category == "compression_model_failure"
+    assert raised.value.retryable is False
+    assert "ignored by the safe boundary" not in str(raised.value)
