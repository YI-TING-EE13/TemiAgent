+class HermesConversationError(RuntimeError):
+    """A safe, structured failure at the simple chat API boundary.
+
+    run_conversation returns diagnostic dictionaries because its callers
+    need the transcript and retry metadata. A failed dictionary is not a
+    successful chat response, however, so chat must not index a response
+    field that may not exist. This exception carries only bounded metadata;
+    provider error text and conversation contents remain outside the resident
+    HTTP response.
+    """
+
+    _SAFE_MESSAGES = {
+        "hermes_compression_exhausted": (
+            "Hermes could not produce a response after bounded context recovery."
+        ),
+        "hermes_conversation_failed": "Hermes could not produce a response.",
+        "hermes_missing_final_response": "Hermes completed without a final response.",
+    }
+
+    def __init__(
+        self,
+        *,
+        error_class: str,
+        safe_message: str,
+        retryable: bool,
+        original_failure_category: str,
+    ) -> None:
+        self.error_class = error_class
+        self.safe_message = safe_message
+        self.retryable = bool(retryable)
+        self.original_failure_category = original_failure_category
+        super().__init__(safe_message)
+
+    def to_dict(self) -> dict[str, object]:
+        """Return the bounded failure contract for an integration boundary."""
+        return {
+            "error_class": self.error_class,
+            "safe_message": self.safe_message,
+            "retryable": self.retryable,
+            "original_failure_category": self.original_failure_category,
+        }
+
+    @staticmethod
+    def _safe_category(value: object, fallback: str) -> str:
+        """Keep category metadata bounded and free of provider/raw text."""
+        if isinstance(value, str) and re.fullmatch(r"[a-z0-9_]{1,80}", value):
+            return value
+        return fallback
+
+    @classmethod
+    def from_result(cls, result: object) -> "HermesConversationError":
+        """Convert a failed conversation result without exposing its error text."""
+        if not isinstance(result, dict):
+            return cls(
+                error_class="hermes_conversation_failed",
+                safe_message=cls._SAFE_MESSAGES["hermes_conversation_failed"],
+                retryable=False,
+                original_failure_category="invalid_result",
+            )
+
+        failure = result.get("failure")
+        if not isinstance(failure, dict):
+            failure = {}
+        compression_exhausted = bool(result.get("compression_exhausted"))
+        default_error_class = (
+            "hermes_compression_exhausted"
+            if compression_exhausted
+            else "hermes_missing_final_response"
+        )
+        error_class = failure.get("error_class")
+        if not isinstance(error_class, str) or error_class not in cls._SAFE_MESSAGES:
+            error_class = default_error_class
+        default_category = (
+            "compression_exhausted" if compression_exhausted else "missing_final_response"
+        )
+        category = cls._safe_category(
+            failure.get("original_failure_category")
+            or result.get("failure_category"),
+            default_category,
+        )
+        retryable = failure.get("retryable")
+        if not isinstance(retryable, bool):
+            retryable = compression_exhausted
+        return cls(
+            error_class=error_class,
+            safe_message=cls._SAFE_MESSAGES[error_class],
+            retryable=retryable,
+            original_failure_category=category,
+        )
+
 
