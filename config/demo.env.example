# Tracked production template. `./scripts/demo init-config --profile production`
# substitutes the one ignored owner-only runtime root. Do not add secrets here.

DEMO_PROFILE=production
DEMO_GIT_BRANCH_POLICY=required
EXPECTED_GIT_BRANCH=main

# Owner-only runtime state. The lifecycle creates subdirectories with mode 0700.
TEMIAGENT_RUNTIME_ROOT=<CANONICAL_RUNTIME_ROOT>
LOG_DIR=<CANONICAL_RUNTIME_ROOT>/logs/bridge
MEMORY_DIR=<CANONICAL_RUNTIME_ROOT>/data/care-memory
DEMO_CARE_MEMORY_ROOT=<CANONICAL_RUNTIME_ROOT>/data/care-memory
TEMI_SHARED_BRIDGE_PATH=<CANONICAL_RUNTIME_ROOT>/data/shared
TEMI_SHARED_HERMES_PATH=<CANONICAL_RUNTIME_ROOT>/data/shared
HERMES_MEDIA_CALLBACK_SOCKET=<CANONICAL_RUNTIME_ROOT>/tmp/sockets/bridge.sock
HERMES_DEMO_IDENTITY_CALLBACK_SOCKET=<CANONICAL_RUNTIME_ROOT>/tmp/sockets/bridge_demo_identity_callback.sock
HERMES_DEMO_CARE_CALLBACK_SOCKET=<CANONICAL_RUNTIME_ROOT>/tmp/sockets/bridge_demo_care_callback.sock
DEMO_IDENTITY_STATE_DIR=<CANONICAL_RUNTIME_ROOT>/state/demo-identity

# LM Studio is an externally managed required dependency. The lifecycle may
# read its HTTP model-list endpoint, but never starts, stops, unloads or
# reconfigures the global provider runtime.
LMSTUDIO_OWNERSHIP=external
LMSTUDIO_TARGET_DIR=/TemiAgent/.lmstudio-data
LMSTUDIO_MODEL_ID=temi/gemma-4-31b-it-qat
LMSTUDIO_API_IDENTIFIER=google/gemma-4-31b
LMSTUDIO_SERVER_PORT=1234
CONTEXT_LENGTH=64000
LMSTUDIO_CONTEXT_LENGTH=64000
LMSTUDIO_VISIBLE_GPUS=0,1

MQTT_OWNERSHIP=managed
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_CONFIG_PATH=/TemiAgent/mqtt/mosquitto.conf

HERMES_GATEWAY_ENABLED=true
HERMES_GATEWAY_OWNERSHIP=managed
MANAGE_ANDROID=0

# Bridge and resident contract.
ROBOT_ID_ALLOWLIST=temi-01
HERMES_INVOKE_MODE=http
HERMES_HTTP_URL=http://127.0.0.1:8765/invoke
HERMES_TIMEOUT_SECONDS=60
TRACE_ENABLED=true
TRACE_INCLUDE_ASR_TEXT=false
DEBUG_TRACE_FULL=false
MEDIA_V11_ENABLED=true
HERMES_MEDIA_TOOL_ENABLED=true
HERMES_MEDIA_FAST_PATH_ENABLED=true

# Demo-only care/identity route. Enable only for its documented synthetic flow.
DEMO_OPERATOR_IDENTITY_ENABLED=true
RESIDENT_IDENTITY_ENABLED=true
HERMES_DEMO_IDENTITY_TOOL_ENABLED=true
HERMES_DEMO_IDENTITY_FAST_PATH_ENABLED=true
CARE_MEMORY_V2_ENABLED=true
DEMO_REPEATED_DISCOMFORT_ENABLED=true
DEMO_CARE_SCENARIO_PROMPT_ENABLED=true
DEMO_RESIDENT_VISUAL_ROUTING_ENABLED=false
CARE_CONTEXT_ENABLED=true
DEMO_IDENTITY_REFRESH_SECONDS=10
DEMO_IDENTITY_MAX_DURATION_SECONDS=900

# Viewer. The Discord credential is a second owner-only env file containing
# DISCORD_WEBHOOK_URL=<private value>; it is never committed or printed.
DEMO_ACTION_VIEWER_ENABLED=true
DEMO_ACTION_VIEWER_MODEL=gemma-4-31b-it-qat-q4-k-xl
DEMO_ACTION_VIEWER_GGUF_MODEL_PATH=/TemiAgent/.lmstudio-data/models/unsloth/gemma-4-31B-it-qat-GGUF/gemma-4-31B-it-qat-UD-Q4_K_XL.gguf
DEMO_ACTION_VIEWER_MMPROJ_PATH=/TemiAgent/.lmstudio-data/models/unsloth/gemma-4-31B-it-qat-GGUF/mmproj-F32.gguf
DEMO_ACTION_VIEWER_LLAMA_SERVER=/TemiAgent/anomaly_detection/third_party/llama.cpp/build/bin/llama-server
DEMO_ACTION_VIEWER_LLAMA_SERVER_PORT=8011
DEMO_ACTION_VIEWER_CUDA_VISIBLE_DEVICES=3
DEMO_ACTION_VIEWER_POSE_MODE=auto
DEMO_ACTION_VIEWER_POSE_MODEL=yolo26x-pose.pt
DEMO_ACTION_VIEWER_POSE_DEVICE=3
DEMO_ACTION_VIEWER_MAX_OUTPUT_TOKENS=96
DEMO_ACTION_VIEWER_ABNORMAL_PUBLISH=disabled
# Retired compatibility switch. `enabled` is rejected because Bridge owns
# abnormal notification delivery.
DEMO_ACTION_VIEWER_DISCORD_NOTIFY=disabled
DEMO_ACTION_VIEWER_PRE_ALERT_SPEAK=disabled
# Bridge-owned abnormal-care notification and formal test ingress. These stay
# disabled in the production sample. A dedicated Demo mock run must enable
# every mock flag together; never set a real Discord webhook for that run.
ABNORMAL_CARE_EPISODE_ENABLED=true
ABNORMAL_CARE_FIRST_RESPONSE_TIMEOUT_SECONDS=120
ABNORMAL_CARE_SECOND_RESPONSE_TIMEOUT_SECONDS=120
ABNORMAL_CARE_TIMEOUT_POLL_SECONDS=5
ABNORMAL_NOTIFICATION_MODE=disabled
ABNORMAL_NOTIFICATION_DISCORD_ENV_PATH=
ABNORMAL_NOTIFICATION_TIMEOUT_SECONDS=15
ABNORMAL_NOTIFICATION_TEST_RECIPIENT_AUTHORIZED=false
DEMO_NOTIFICATION_MOCK_ENABLED=false
DEMO_NOTIFICATION_RECEIPT_ENABLED=false
DEMO_TEST_EVENT_INGRESS_ENABLED=false
DEMO_TEST_RESIDENT_ALLOWLIST=test-resident
DEMO_START_TIMEOUT_SECONDS=180
