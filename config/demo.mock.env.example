# Tracked safe-default template for `./scripts/demo init-config`.
# Its test doubles never contact a real Temi, GPU model, Discord, or Android.

DEMO_PROFILE=newcomer_mock
DEMO_GIT_BRANCH_POLICY=disabled
TEMIAGENT_RUNTIME_ROOT=<CANONICAL_RUNTIME_ROOT>
LOG_DIR=<CANONICAL_RUNTIME_ROOT>/logs/bridge
MEMORY_DIR=<CANONICAL_RUNTIME_ROOT>/data/care-memory
TEMI_SHARED_BRIDGE_PATH=<CANONICAL_RUNTIME_ROOT>/data/shared
TEMI_SHARED_HERMES_PATH=<CANONICAL_RUNTIME_ROOT>/data/shared
HERMES_MEDIA_CALLBACK_SOCKET=<CANONICAL_RUNTIME_ROOT>/tmp/sockets/bridge.sock

# These production identifiers remain part of the resolved contract. The
# lifecycle starts a local model-list test double instead of LM Studio itself.
LMSTUDIO_OWNERSHIP=managed
LMSTUDIO_TARGET_DIR=<CANONICAL_RUNTIME_ROOT>/data/mock-lmstudio
LMSTUDIO_MODEL_ID=temi/gemma-4-31b-it-qat
LMSTUDIO_API_IDENTIFIER=google/gemma-4-31b
LMSTUDIO_SERVER_PORT=29134
CONTEXT_LENGTH=64000
LMSTUDIO_CONTEXT_LENGTH=64000
LMSTUDIO_VISIBLE_GPUS=0,1

MQTT_OWNERSHIP=managed
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=29183

ADAPTER_VISION_PORT=29080
ADAPTER_FRAME_BROADCAST_PORT=29081
RESIDENT_HTTP_PORT=29765
VIEWER_HTTP_PORT=29010
VIEWER_AUX_PORT=29011
MOCK_ANDROID_HEALTH_PORT=29012
MOCK_DISCORD_PORT=29013

HERMES_GATEWAY_ENABLED=false
HERMES_GATEWAY_OWNERSHIP=disabled
MANAGE_ANDROID=0
ROBOT_ID_ALLOWLIST=temi-01
HERMES_INVOKE_MODE=http
HERMES_HTTP_URL=http://127.0.0.1:29765/invoke
HERMES_TIMEOUT_SECONDS=15
TRACE_ENABLED=true
TRACE_INCLUDE_ASR_TEXT=false
DEBUG_TRACE_FULL=false

# The normal Bridge media callback and validators remain enabled. The mock
# resident does not publish MQTT; media tests use the Bridge callback contract.
MEDIA_V11_ENABLED=true
HERMES_MEDIA_TOOL_ENABLED=true
HERMES_MEDIA_FAST_PATH_ENABLED=true
DEMO_OPERATOR_IDENTITY_ENABLED=false
RESIDENT_IDENTITY_ENABLED=false
HERMES_DEMO_IDENTITY_TOOL_ENABLED=false
HERMES_DEMO_IDENTITY_FAST_PATH_ENABLED=false
CARE_MEMORY_V2_ENABLED=false
DEMO_REPEATED_DISCOMFORT_ENABLED=false
DEMO_CARE_SCENARIO_PROMPT_ENABLED=false
DEMO_RESIDENT_VISUAL_ROUTING_ENABLED=false
CARE_CONTEXT_ENABLED=false

DEMO_ACTION_VIEWER_ENABLED=true
DEMO_ACTION_VIEWER_DISCORD_NOTIFY=disabled
# This profile uses no real Discord recipient. The formal injector may publish
# synthetic abnormal events only when all three Demo flags remain true.
ABNORMAL_CARE_EPISODE_ENABLED=true
ABNORMAL_CARE_FIRST_RESPONSE_TIMEOUT_SECONDS=15
ABNORMAL_CARE_SECOND_RESPONSE_TIMEOUT_SECONDS=15
ABNORMAL_CARE_TIMEOUT_POLL_SECONDS=1
ABNORMAL_NOTIFICATION_MODE=demo_mock
ABNORMAL_NOTIFICATION_DISCORD_ENV_PATH=
ABNORMAL_NOTIFICATION_TIMEOUT_SECONDS=5
ABNORMAL_NOTIFICATION_TEST_RECIPIENT_AUTHORIZED=false
DEMO_NOTIFICATION_MOCK_ENABLED=true
DEMO_NOTIFICATION_RECEIPT_ENABLED=true
DEMO_TEST_EVENT_INGRESS_ENABLED=true
DEMO_TEST_RESIDENT_ALLOWLIST=test-resident
DEMO_START_TIMEOUT_SECONDS=30
