#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE="${1:---check}"

if [[ "$MODE" == "--hermes" ]]; then
  exec "$ROOT/scripts/bootstrap_hermes.sh"
fi

if [[ "$MODE" != "--check" && "$MODE" != "--sync" ]]; then
  echo "usage: ./scripts/bootstrap [--check|--sync|--hermes]" >&2
  exit 2
fi

cd "$ROOT"
test "$(git rev-parse --show-toplevel)" = "$ROOT"
test -d hermes-agent/.git
MANIFEST="$ROOT/third_party/hermes/manifest.json"
test -f "$MANIFEST"
EXPECTED_TREE="$(python3 - "$MANIFEST" <<'PY'
import json
import sys

manifest = json.load(open(sys.argv[1], encoding="utf-8"))
print(manifest["target_tree_sha"])
PY
)"
CURRENT_TREE="$(git -C hermes-agent rev-parse HEAD^{tree})"
if [[ "$EXPECTED_TREE" != "$CURRENT_TREE" ]]; then
  echo "nested Hermes tree does not match third_party/hermes/manifest.json; run ./scripts/bootstrap --hermes" >&2
  exit 1
fi

for command in uv mosquitto; do
  command -v "$command" >/dev/null
done
test -x hermes-agent/venv/bin/python3
test -x hermes-agent/venv/bin/hermes
test -x anomaly_detection/.venv/bin/python
test -x anomaly_detection/third_party/llama.cpp/build/bin/llama-server
test -x .lmstudio-data/bin/lms
test -f mqtt/mosquitto.conf
test -f config/demo.env.example
test -f config/demo_resources.json

if [[ "$MODE" == "--sync" ]]; then
  (cd hermes_temi_bridge && uv sync --frozen --extra mqtt)
  (cd temi_backend && uv sync --frozen)
  (cd anomaly_detection && uv sync --frozen)
fi

echo "bootstrap ${MODE#--}: PASS"
