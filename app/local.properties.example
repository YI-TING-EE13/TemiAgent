# local.properties.example — Copy this to local.properties and edit values
#
# WebSocket server URLs for video streaming.
# Multiple backend machines are comma-separated.
ws.server.urls=ws://192.168.50.233:8080,ws://192.168.50.236:8080

# MQTT broker URLs.
# Multiple brokers are comma-separated.
mqtt.broker.urls=tcp://192.168.50.233:1883,tcp://192.168.50.236:1883

# MQTT Client ID (must be unique per device)
mqtt.client.id=temi-agent

# Stable Temi robot id used by HermesTemiBridge MQTT topics.
robot.id=temi-01
