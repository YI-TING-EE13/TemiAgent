MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

ROBOT_ID_ALLOWLIST=temi-01

TEMI_SHARED_BRIDGE_PATH=/TemiAgent/temi_shared
TEMI_SHARED_HERMES_PATH=/shared/temi

HERMES_INVOKE_MODE=http
HERMES_CLI_COMMAND=/TemiAgent/hermes-agent/venv/bin/hermes chat -q {prompt} -Q
HERMES_HTTP_URL=http://127.0.0.1:8765/invoke
HERMES_MOCK_RESPONSE_TEXT=這是 Bridge mock 測試
HERMES_TIMEOUT_SECONDS=60

MAX_ACTIONS_PER_EVENT=5
MAX_IMAGE_SIZE_MB=8
EVENT_DEDUP_TTL_SECONDS=600

LOG_LEVEL=INFO
LOG_DIR=logs/events
TRACE_ENABLED=true
DEBUG_TRACE_FULL=false
TRACE_INCLUDE_ASR_TEXT=true
TRACE_RUN_ID=
TRACE_MAX_FIELD_CHARS=2000

# Keep disabled until the deployed Android consumer passes media v1.1 integration tests.
MEDIA_V11_ENABLED=false
# Keep disabled unless the resident worker and Bridge share a private Unix callback socket.
HERMES_MEDIA_TOOL_ENABLED=false
HERMES_MEDIA_CALLBACK_SOCKET=

# Controlled Demo context only. The runtime root is private and must not be the tracked memory/ directory.
DEMO_CARE_SCENARIO_PROMPT_ENABLED=false
DEMO_RESIDENT_VISUAL_ROUTING_ENABLED=false
DEMO_CARE_MEMORY_ROOT=
DEMO_RESIDENT_CONTEXT_TTL_SECONDS=300
DEMO_RESIDENT_VISUAL_MINIMUM_CONFIDENCE=0.70
