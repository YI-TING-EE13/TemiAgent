MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

ROBOT_ID_ALLOWLIST=temi-01

TEMI_SHARED_BRIDGE_PATH=/TemiAgent/temi_shared
TEMI_SHARED_HERMES_PATH=/shared/temi

HERMES_INVOKE_MODE=http
HERMES_CLI_COMMAND=/TemiAgent/hermes-agent/venv/bin/hermes chat -q {prompt} -Q
HERMES_HTTP_URL=http://127.0.0.1:8765/invoke
HERMES_MOCK_RESPONSE_TEXT=這是 Bridge mock 測試
HERMES_TIMEOUT_SECONDS=60

MAX_ACTIONS_PER_EVENT=5
MAX_IMAGE_SIZE_MB=8
EVENT_DEDUP_TTL_SECONDS=600

LOG_LEVEL=INFO
LOG_DIR=logs/events
TRACE_ENABLED=true
DEBUG_TRACE_FULL=false
TRACE_INCLUDE_ASR_TEXT=true
TRACE_RUN_ID=
TRACE_MAX_FIELD_CHARS=2000

# The Bridge keeps a bounded, non-secret abnormal-care confirmation record under MEMORY_DIR.
ABNORMAL_CARE_CONFIRMATION_ENABLED=true
ABNORMAL_CARE_CONFIRMATION_TTL_SECONDS=120
ABNORMAL_CARE_CONFIRMATION_MIN_ASR_CONFIDENCE=0.70
# The Bridge validates the event, records one immediate-alert receipt, invokes
# Resident Hermes, and owns the follow-up state machine. Production starts with
# all notification and formal-injector routes disabled.
ABNORMAL_CARE_EPISODE_ENABLED=true
ABNORMAL_CARE_FIRST_RESPONSE_TIMEOUT_SECONDS=120
ABNORMAL_CARE_SECOND_RESPONSE_TIMEOUT_SECONDS=120
ABNORMAL_CARE_TIMEOUT_POLL_SECONDS=5
ABNORMAL_NOTIFICATION_MODE=disabled
ABNORMAL_NOTIFICATION_DISCORD_ENV_PATH=
ABNORMAL_NOTIFICATION_TIMEOUT_SECONDS=15
ABNORMAL_NOTIFICATION_TEST_RECIPIENT_AUTHORIZED=false
DEMO_NOTIFICATION_MOCK_ENABLED=false
DEMO_NOTIFICATION_RECEIPT_ENABLED=false
DEMO_TEST_EVENT_INGRESS_ENABLED=false
DEMO_TEST_RESIDENT_ALLOWLIST=test-resident

# Keep disabled until the deployed Android consumer passes media v1.1 integration tests.
MEDIA_V11_ENABLED=false
# Keep disabled unless the resident worker and Bridge share a private Unix callback socket.
HERMES_MEDIA_TOOL_ENABLED=false
HERMES_MEDIA_CALLBACK_SOCKET=
# Resident-only deterministic matcher; requires both Media flags and remains
# false outside an explicitly authorised Demo private environment.
HERMES_MEDIA_FAST_PATH_ENABLED=false

# Controlled Demo context only. The runtime root is private and must not be the tracked memory/ directory.
DEMO_CARE_SCENARIO_PROMPT_ENABLED=false
DEMO_RESIDENT_VISUAL_ROUTING_ENABLED=false
# Demo-only manual selection is an explicit bounded operator command. It never
# identifies a resident from free speech and publishes the existing identity v1.0 schema.
DEMO_OPERATOR_IDENTITY_ENABLED=false
# Canonical identity controls: Bridge admission, native tool registration and deterministic matching.
RESIDENT_IDENTITY_ENABLED=false
HERMES_DEMO_IDENTITY_TOOL_ENABLED=false
HERMES_DEMO_IDENTITY_FAST_PATH_ENABLED=false
# Care Memory v2 is required before the bounded repeated-discomfort route can start.
CARE_MEMORY_V2_ENABLED=false
DEMO_REPEATED_DISCOMFORT_ENABLED=false
DEMO_CARE_MEMORY_ROOT=
DEMO_RESIDENT_CONTEXT_TTL_SECONDS=300
DEMO_RESIDENT_VISUAL_MINIMUM_CONFIDENCE=0.70
HERMES_DEMO_IDENTITY_CALLBACK_SOCKET=
HERMES_DEMO_CARE_CALLBACK_SOCKET=
DEMO_IDENTITY_STATE_DIR=
DEMO_IDENTITY_REFRESH_SECONDS=10
DEMO_IDENTITY_MAX_DURATION_SECONDS=900
