{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://temiagent.local/schemas/perception_abnormal_event.schema.json",
  "title": "TemiAgent canonical abnormal perception event",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "event_id",
    "robot_id",
    "type",
    "event_type",
    "timestamp_ms",
    "observation",
    "evidence",
    "context"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "robot_id": {"type": "string", "minLength": 1},
    "type": {"const": "perception.abnormal"},
    "event_type": {
      "type": "string",
      "enum": ["falls_down", "lies_on_floor", "fight", "other_allowlisted"]
    },
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "observation": {
      "type": "object",
      "required": ["action_name", "reason"],
      "properties": {
        "action_name": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["frame_paths"],
      "properties": {
        "frame_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "test": {"type": "boolean"},
        "resident_id": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"context": {"properties": {"test": {"const": true}}, "required": ["test"]}}},
      "then": {
        "properties": {
          "context": {"required": ["resident_id", "request_id", "run_id", "scenario_id"]}
        }
      }
    }
  ]
}
